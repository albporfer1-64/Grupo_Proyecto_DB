@startuml
object "<u>amina : Apadrinado</u>" as amina {
  nombre = "Amina Diop"
  edad = 18
}

object "<u>misionApadrinado : Mision</u>" as misionApadrinado {
  estado = "FINALIZADA"
}

object "<u>misionEscuela : Mision</u>" as misionEscuela {
  estado = "ACTIVA"
}

object "<u>mecanica : Especialidad</u>" as mecanica {
  nombre = "Mecánica"
}

object "<u>materiales : Asignatura</u>" as materiales {
  nombre = "Materiales"
}

object "<u>teoriaMovimiento : Asignatura</u>" as teoriaMovimiento {
  nombre = "Teoría del Movimiento"
}

object "<u>inscripcion1 : Inscripcion</u>" as inscripcion1

amina -- misionApadrinado : finalizó
amina -- misionEscuela : cursa
misionEscuela -- mecanica : imparte
mecanica -- materiales : contiene
mecanica -- teoriaMovimiento : contiene
amina -- inscripcion1 : realiza
inscripcion1 -- materiales : inscrita en
@enduml