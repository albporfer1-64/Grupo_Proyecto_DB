class Persona{
    nombre VARCHAR
    apellidos VARCHAR
    fechaNacimiento DATE (puede ser NULL)
}

'Subclases de Persona:
Persona <|-- Apadrinado
Persona <|-- Estudiante_O
Persona <|-- Estudiante_B
Persona <|-- Benefactor
Persona <|-- Empleado
Persona <|-- Trabajador

'Restricción de cobertura:
note on link : {completa, disjunta}

class Trabajador{
    NIF VARCHAR
    correo VARCHAR
    telefono
}

class Empleado{
    NIF VARCHAR
    correo VARCHAR
    telefono
    rol VARCHAR
}

class Benefactor{
    NIF VARCHAR
    telefono
    horasPosiblesLlamadas VARCHAR
    correo VARCHAR
    individuo  
}

class Estudiante_B{
    correo VARCHAR
    telefono
    QueEstudia VARCHAR
    destino VARCHAR
}

class Estudiante_O{
    correo VARCHAR
    telefono
    QueEstudia_Enum VARCHAR
}

class Apadrinado{
    fechaFinApadrinado
    localidad VARCHAR
    nombreTutor STRING
    telefonoTutor INT
    emailTutor STRING
}